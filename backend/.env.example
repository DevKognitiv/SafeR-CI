# SafeR CI — backend environment
# Copy to .env and fill in values. Never commit the real .env.

# --- App ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true

# --- Database (PostGIS-enabled Postgres) ---
# Matches backend/docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://safer:safer_pass@localhost:5432/safer_ci
DATABASE_POOL_SIZE=10

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (comma-separated handled by pydantic List parsing) ---
# ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Firebase (push) ---
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# --- WhatsApp Business API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- HA / hub webhook ---
HUB_WEBHOOK_SECRET=
