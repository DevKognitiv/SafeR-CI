# SafeR CI backend — copy to .env and fill in the values
# ---------------------------------------------------------------- core API
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
DATABASE_URL=postgresql+asyncpg://safer:safer_pass@db:5432/safer_ci
REDIS_URL=redis://redis:6379/0

# Twilio (SMS alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Firebase (push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# WhatsApp Business API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Home Assistant node webhook secret
HUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------- SafeR Hub (smart home & security)
# Database for the hub (defaults to DATABASE_URL; SQLite works for a Raspberry Pi hub)
HUB_DATABASE_URL=
# Fernet key for device credentials at rest (derived from SECRET_KEY when empty):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUB_ENCRYPTION_KEY=
HUB_TOKEN_TTL_DAYS=30
HUB_POLL_INTERVAL=30
HUB_WEATHER_ENABLED=true
HUB_DEMO_ENABLED=true
HUB_ALLOW_OPEN_REGISTRATION=true
# Oldest app version this hub serves (announced on /health for the forced-update screen)
HUB_MIN_APP_VERSION=0.2.0
# Run Alembic migrations on startup (false: run `python -m alembic -c alembic.ini upgrade head` yourself)
HUB_AUTO_MIGRATE=true
# Refuse an SOS without phone/home position unless the user confirmed an address (Phase 2 turns it on)
SAFER_SOS_REQUIRE_ADDRESS=false
# Send camera credentials to phones in GET /devices/{id}/stream (LAN risk; off until the hub relay exists)
HUB_STREAM_CREDENTIALS_TO_CLIENTS=false
# Rate limits + lockout on /auth (per process; one uvicorn worker on a Raspberry Pi hub)
HUB_RATE_LIMIT_ENABLED=true
HUB_TRUST_PROXY_HEADERS=false
HUB_LOGIN_PER_IP_PER_MINUTE=10
HUB_LOGIN_PER_ACCOUNT_PER_MINUTE=5
HUB_REGISTER_PER_IP_PER_HOUR=5
HUB_PUSH_TOKEN_PER_USER_PER_MINUTE=10
HUB_LOGIN_LOCKOUT_THRESHOLD=5
HUB_LOGIN_LOCKOUT_WINDOW_SECONDS=900
HUB_LOGIN_LOCKOUT_SECONDS=900
# SIA DC-09 receiver for Ajax / Hikvision AX PRO / any alarm panel (0 = disabled)
HUB_SIA_PORT=0
HUB_SIA_ACCOUNTS=
# python-matter-server WebSocket (see docker-compose matter-server service)
MATTER_SERVER_URL=ws://host.docker.internal:5580/ws
# Forward SOS alerts raised in the app to the SafeR CI incident API
SAFER_INCIDENTS_URL=http://api:8000/api/v1/incidents/
SAFER_INCIDENTS_TOKEN=
