# ---- Secrets (never commit real values; update the .example files instead) ----
.env
.env.*
!.env.example
!.env.*.example
ha-config/secrets.yaml
backend/ssl/
*.pem
*.key
!**/*.example.key

# ---- Node / Next.js (web-dashboard) ----
node_modules/
.next/
out/
next-env.d.ts
.vercel
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---- Python (backend) ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Flutter / Dart (mobile) ----
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
mobile/ios/Pods/
mobile/ios/Flutter/Flutter.framework
mobile/android/.gradle/
mobile/android/local.properties
*.iml

# ---- Home Assistant runtime artifacts ----
ha-config/.storage/
ha-config/home-assistant_v2.db*
ha-config/home-assistant.log*
ha-config/.cloud/

# ---- Editors / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Claude Code (keep shared settings.json, ignore personal overrides) ----
.claude/settings.local.json
