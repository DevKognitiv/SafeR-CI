<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay of src/main/res/xml/network_security_config.xml.

  Developer builds talk to a hub on a LAN IP (flutter run with
  SAFER_HUB_URL=http://192.168.1.20:8000), which Android cannot allow-list by
  range, so cleartext is permitted everywhere here. Release and profile builds
  keep the restrictive main configuration.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
