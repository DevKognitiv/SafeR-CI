<?xml version="1.0" encoding="utf-8"?>
<!--
  SafeR transport policy (release and profile builds).

  Cleartext HTTP is off by default: the session token and the login password
  must only travel over TLS. The single exception is the local network, where
  the SafeR hub (Raspberry Pi) usually has no certificate:
    - localhost / 127.0.0.1 (hub running on the phone or forwarded with adb),
    - 10.0.2.2 (the host machine seen from the Android emulator),
    - *.local (mDNS names such as safer-hub.local, includeSubdomains).

  Android cannot express RFC 1918 ranges (10/8, 172.16/12, 192.168/16) in a
  domain-config, so in release builds a LAN hub on a raw IP must be reached by
  its .local name or over https; Phase 4 ships mDNS/QR hub discovery so users
  never type an IP. Debug builds overlay this file with
  src/debug/res/xml/network_security_config.xml, which permits cleartext
  everywhere so developer builds on LAN IPs keep working.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">local</domain>
    </domain-config>
</network-security-config>
