# SafeR CI Web Dashboard — Environment Variables
# Copy to .env.local for local development

# Server-only base URL for the FastAPI backend (used by /api/* proxy routes).
# Defaults to NEXT_PUBLIC_API_URL below if unset.
# SAFER_API_URL=http://localhost:8000

# API Backend URL (also used as the proxy fallback)
NEXT_PUBLIC_API_URL=http://localhost:8000

# App
NEXT_PUBLIC_APP_NAME=SafeR CI
NEXT_PUBLIC_APP_ENV=development

# Map defaults (Abidjan center)
NEXT_PUBLIC_MAP_DEFAULT_LAT=5.3484
NEXT_PUBLIC_MAP_DEFAULT_LON=-4.0107
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12
