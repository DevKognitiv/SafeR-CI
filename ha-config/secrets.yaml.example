# SafeR CI — Fichier Secrets Home Assistant
# ATTENTION: NE JAMAIS COMMITER CE FICHIER AVEC DE VRAIES VALEURS
# Copiez ce fichier en 'secrets.yaml' et remplissez vos vraies valeurs
# Le fichier secrets.yaml est dans .gitignore

# ============================================================
# TWILIO SMS / WHATSAPP
# ============================================================
twilio_account_sid: "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
twilio_auth_token: "your_auth_token_here"
twilio_from_number: "+1XXXXXXXXXX"  # Votre numéro Twilio

# Contacts d'urgence (numéros en format international +225...)
emergency_contact_1: "+225XXXXXXXXXX"  # Administrateur principal
emergency_contact_2: "+225XXXXXXXXXX"  # Administrateur secondaire
safer_admin_phone: "+225XXXXXXXXXX"   # Téléphone admin SafeR

# Numéros des services d'urgence (dispatch)
police_dispatch_number: "+225XXXXXXXXXX"  # Centre dispatch Police
pompiers_dispatch_number: "+225XXXXXXXXXX"  # Caserne pompiers principale
samu_dispatch_number: "+225XXXXXXXXXX"  # SAMU central
gendarmerie_dispatch_number: "+225XXXXXXXXXX"  # Gendarmerie nationale

# WhatsApp
whatsapp_group_id: "whatsapp:+225XXXXXXXXXX"  # Groupe WhatsApp d'urgence

# ============================================================
# API BACKEND SAFER
# ============================================================
safer_api_key: "your_safer_api_key_here"  # Clé API FastAPI/Next.js
safer_api_base_url: "http://localhost:8000"  # URL du backend en production

# ============================================================
# WEBHOOKS HOME ASSISTANT
# ============================================================
# Générez des IDs aléatoires sécurisés (ex: openssl rand -hex 32)
safer_webhook_sos: "your_random_webhook_id_for_sos"
safer_webhook_dispatch: "your_random_webhook_id_for_dispatch"
safer_webhook_resolve: "your_random_webhook_id_for_resolve"
ha_webhook_secret: "your_ha_webhook_secret_here"

# ============================================================
# MQTT BROKER
# ============================================================
mqtt_broker_host: "localhost"  # ou IP du broker MQTT
mqtt_broker_port: "1883"
mqtt_username: "safer_ha"
mqtt_password: "your_mqtt_password"

# ============================================================
# HOME ASSISTANT
# ============================================================
ha_url: "http://homeassistant.local:8123"
ha_long_lived_token: "your_ha_long_lived_access_token"

# ============================================================
# BASE DE DONNEES (optionnel si utilisation PostgreSQL externe)
# ============================================================
db_password: "your_db_password"
db_host: "localhost"

# ============================================================
# FIREBASE (pour notifications push Flutter)
# ============================================================
firebase_server_key: "your_firebase_server_key"
firebase_project_id: "safer-ci-abidjan"
